{
  "name": "echomind-desktop",
  "productName": "EchoMind",
  "version": "0.1.0",
  "description": "Turn every recording into knowledge, documents and action.",
  "private": true,
  "license": "UNLICENSED",
  "author": "EchoMind",
  "main": "./out/main/index.js",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.66.0",
    "mediabunny": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "scripts": {
    "dev": "node scripts/run.mjs electron-vite dev",
    "build": "electron-vite build",
    "start": "node scripts/run.mjs electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:e2e": "electron-vite build && node scripts/run.mjs playwright test",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:licenses",
    "dist": "electron-vite build && electron-builder --win",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs"
  },
  "build": {
    "appId": "com.echomind.desktop",
    "productName": "EchoMind",
    "files": [
      "out/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}