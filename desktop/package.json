{
  "name": "echomind-desktop",
  "productName": "EchoMind",
  "version": "0.4.0",
  "description": "Turn every recording into knowledge, documents and action.",
  "private": true,
  "license": "UNLICENSED",
  "author": "EchoMind",
  "main": "./out/main/index.js",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.5.438",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "docx": "^9.15.3",
    "lucide-react": "^1.66.0",
    "mediabunny": "^1.65.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "image-size": "^2.1.0"
  },
  "scripts": {
    "dev": "node scripts/run.mjs electron-vite dev",
    "build": "electron-vite build",
    "start": "node scripts/run.mjs electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:e2e": "electron-vite build && node scripts/run.mjs playwright test",
    "test:live": "electron-vite build && node scripts/run.mjs playwright test -c playwright.live.config.ts",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:licenses",
    "dist": "electron-vite build && electron-builder --win",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "fetch:whisper": "node scripts/fetch-whisper.mjs",
    "fetch:llama": "node scripts/fetch-llama.mjs",
    "fetch:sherpa": "node scripts/fetch-sherpa.mjs",
    "icon": "node scripts/run.mjs electron scripts/make-icon.mjs",
    "test:packaged": "node scripts/run.mjs playwright test -c playwright.packaged.config.ts"
  },
  "build": {
    "appId": "com.echomind.desktop",
    "productName": "EchoMind",
    "files": [
      "out/**",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EchoMind",
      "artifactName": "EchoMind-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "fileAssociations": [
      {
        "ext": "echomind",
        "name": "EchoMind bundle",
        "description": "A recording shared from EchoMind",
        "role": "Editor"
      }
    ]
  }
}
